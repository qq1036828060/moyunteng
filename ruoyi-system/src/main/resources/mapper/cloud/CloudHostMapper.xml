<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.CloudHostMapper">

    <resultMap type="CloudHost" id="CloudHostResult">
        <id property="hostId" column="host_id"/>
        <result property="hostName" column="host_name"/>
        <result property="hostIp" column="host_ip"/>
        <result property="apiPort" column="api_port"/>
        <result property="apiBaseUrl" column="api_base_url"/>
        <result property="deviceId" column="device_id"/>
        <result property="model" column="model"/>
        <result property="currentVersion" column="current_version"/>
        <result property="latestVersion" column="latest_version"/>
        <result property="onlineStatus" column="online_status"/>
        <result property="enabled" column="enabled"/>
        <result property="containerCapacity" column="container_capacity"/>
        <result property="lastSyncTime" column="last_sync_time"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectCloudHostVo">
        select host_id, host_name, host_ip, api_port, api_base_url, device_id, model,
               current_version, latest_version, online_status, enabled, container_capacity,
               last_sync_time, remark, create_by, create_time, update_by, update_time, del_flag
        from cloud_host
    </sql>

    <select id="selectCloudHostList" parameterType="CloudHost" resultMap="CloudHostResult">
        <include refid="selectCloudHostVo"/>
        <where>
            del_flag = '0'
            <if test="hostName != null and hostName != ''">and host_name like concat('%', #{hostName}, '%')</if>
            <if test="hostIp != null and hostIp != ''">and host_ip like concat('%', #{hostIp}, '%')</if>
            <if test="onlineStatus != null and onlineStatus != ''">and online_status = #{onlineStatus}</if>
            <if test="enabled != null and enabled != ''">and enabled = #{enabled}</if>
        </where>
        order by host_id desc
    </select>

    <select id="selectCloudHostById" parameterType="Long" resultMap="CloudHostResult">
        <include refid="selectCloudHostVo"/>
        where host_id = #{hostId} and del_flag = '0'
    </select>

    <insert id="insertCloudHost" parameterType="CloudHost" useGeneratedKeys="true" keyProperty="hostId">
        insert into cloud_host(host_name, host_ip, api_port, api_base_url, online_status, enabled,
                               container_capacity, remark, create_by, create_time)
        values(#{hostName}, #{hostIp}, #{apiPort}, #{apiBaseUrl}, #{onlineStatus}, #{enabled},
               #{containerCapacity}, #{remark}, #{createBy}, sysdate())
    </insert>

    <update id="updateCloudHost" parameterType="CloudHost">
        update cloud_host
        <set>
            <if test="hostName != null and hostName != ''">host_name = #{hostName},</if>
            <if test="hostIp != null and hostIp != ''">host_ip = #{hostIp},</if>
            <if test="apiPort != null">api_port = #{apiPort},</if>
            <if test="apiBaseUrl != null">api_base_url = #{apiBaseUrl},</if>
            <if test="deviceId != null">device_id = #{deviceId},</if>
            <if test="model != null">model = #{model},</if>
            <if test="currentVersion != null">current_version = #{currentVersion},</if>
            <if test="latestVersion != null">latest_version = #{latestVersion},</if>
            <if test="onlineStatus != null">online_status = #{onlineStatus},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="containerCapacity != null">container_capacity = #{containerCapacity},</if>
            <if test="lastSyncTime != null">last_sync_time = #{lastSyncTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where host_id = #{hostId}
    </update>

    <update id="deleteCloudHostByIds" parameterType="Long">
        update cloud_host set del_flag = '2' where host_id in
        <foreach collection="array" item="hostId" open="(" separator="," close=")">
            #{hostId}
        </foreach>
    </update>
</mapper>

